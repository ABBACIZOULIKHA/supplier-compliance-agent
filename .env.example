# --- PostgreSQL (two roles: read-only for queries, insert-only for reports) ---
DB_READER_URL=postgresql://agent_reader:reader_pw@localhost:5432/supplier_demo
DB_WRITER_URL=postgresql://agent_writer:writer_pw@localhost:5432/supplier_demo

# --- Ollama (local, free). Check the exact tag with:  ollama list ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
# Qwen3 "thinking" mode: keep false for small models (faster, cleaner JSON)
OLLAMA_THINK=false

# --- Paths (relative to project root) ---
CONTRACTS_DIR=data/contracts
LOG_DIR=logs

# --- Agent mode ---
MAX_AGENT_STEPS=12

# --- Alerts for HIGH risk reports (all optional) ---
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
